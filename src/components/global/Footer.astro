---
import Icon from '../ui/Icon.astro';
import {
  siteConfig,
  getCalendarUrl,
  isExternalCalendarUrl,
  getWhatsAppUrl,
  getPhoneHref,
  type WhatsAppContextKey,
} from '../../data/siteConfig';

interface Props {
  whatsappContext?: WhatsAppContextKey;
}

const { whatsappContext = 'inicio' } = Astro.props;
const calendarHref = getCalendarUrl('/contacto#agendar');
const calendarExternal = isExternalCalendarUrl();
const whatsappHref = getWhatsAppUrl(whatsappContext);
const phoneHref = getPhoneHref();
const currentYear = new Date().getFullYear();
---

<footer class="bg-charcoal-950 border-t border-charcoal-750 pt-16 pb-12 text-charcoal-300">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-12 pb-14 border-b border-charcoal-750">
      <!-- Columna 1 (4 cols): Identidad y Dirección Creativa -->
      <div class="lg:col-span-4 space-y-5">
        <a
          href="/"
          class="inline-block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cobalt-400"
          aria-label="Cobalto Carmesí Studios — Inicio"
        >
          <img
            src="/brand/logo-cobalto-horizontal.svg"
            alt="Cobalto Carmesí Studios"
            width="210"
            height="44"
            loading="lazy"
            class="h-9 w-auto object-contain"
          />
        </a>
        <p class="text-sm leading-relaxed text-charcoal-300 max-w-sm">
          {siteConfig.brand.positioningStatement}
        </p>
        <div class="pt-2 border-t border-charcoal-750/80 space-y-1">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-cobalt-300">
            Dirección Creativa
          </p>
          <p class="font-display text-base font-medium text-paper-bone">
            {siteConfig.brand.creativeDirector.name}
          </p>
          <p class="text-xs text-charcoal-400">
            {siteConfig.brand.locationScope}
          </p>
        </div>
      </div>

      <!-- Columna 2 (3 cols): Servicios Prioritarios yNavegación -->
      <div class="lg:col-span-3 space-y-4">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-paper-bone">
          Servicios Prioritarios y Estudio
        </h2>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-paper-pure transition-colors">Inicio</a>
          </li>
          {
            siteConfig.navigation.main.map((item) => (
              <li>
                <a href={item.href} class="hover:text-paper-pure transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/contacto" class="hover:text-paper-pure transition-colors">
              Contacto y Agenda
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3 (3 cols): Especialidades y Cobertura -->
      <div class="lg:col-span-3 space-y-4">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-paper-bone">
          Líneas Especializadas
        </h2>
        <ul class="space-y-2.5 text-sm">
          {
            siteConfig.navigation.complementary.map((item) => (
              <li>
                <a href={item.href} class="hover:text-paper-pure transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4 (2 cols): Acción Directa -->
      <div class="lg:col-span-2 space-y-4">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-[0.14em] text-paper-bone">
          Canales Directos
        </h2>
        <div class="flex flex-col gap-3">
          <a
            href={calendarHref}
            target={calendarExternal ? '_blank' : undefined}
            rel={calendarExternal ? 'noopener noreferrer' : undefined}
            data-track-cta="calendar"
            data-cta="footer-calendar"
            data-cta-location="footer"
            class="inline-flex min-h-[44px] items-center gap-2 rounded bg-cobalt-600 px-3.5 py-2.5 text-xs font-semibold tracking-wide text-paper-pure transition-all hover:bg-cobalt-500"
          >
            <Icon name="calendar" class="w-4 h-4 shrink-0" />
            <span>Agendar videollamada</span>
          </a>

          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            data-track-cta="whatsapp"
            data-cta="footer-whatsapp"
            data-cta-location="footer"
            class="inline-flex min-h-[44px] items-center gap-2 rounded border border-charcoal-700 bg-charcoal-900 px-3.5 py-2.5 text-xs font-medium text-paper-bone transition-colors hover:border-cobalt-400 hover:bg-charcoal-800"
          >
            <Icon name="message-circle" class="w-4 h-4 shrink-0 text-cobalt-400" />
            <span>Escribir por WhatsApp</span>
          </a>

          <a
            href={phoneHref}
            data-track-cta="phone"
            data-cta="footer-phone"
            data-cta-location="footer"
            class="inline-flex min-h-[40px] items-center gap-2 text-xs text-charcoal-300 hover:text-paper-bone transition-colors"
          >
            <Icon name="phone" class="w-4 h-4 shrink-0 text-crimson-500" />
            <span>
              {siteConfig.integrations.phone.displayNumber ||
                siteConfig.integrations.phone.fallbackLabel}
            </span>
          </a>
        </div>
      </div>
    </div>

    <!-- Pie Legal y Transición de Marca -->
    <div class="pt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between text-xs text-charcoal-400">
      <div class="space-y-1">
        <p>
          © {currentYear} {siteConfig.brand.name}. Todos los derechos reservados.
        </p>
        <p class="text-charcoal-400">
          {siteConfig.brand.legalTransitionNote}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-6">
        <a
          href="/privacidad"
          class="text-charcoal-300 hover:text-paper-bone underline decoration-charcoal-700 underline-offset-4 transition-colors"
        >
          Aviso de Privacidad
        </a>
        <a
          href="/el-estudio"
          class="text-charcoal-300 hover:text-paper-bone transition-colors"
        >
          El Estudio
        </a>
        <a
          href="/contacto"
          class="text-charcoal-300 hover:text-paper-bone transition-colors"
        >
          Contacto
        </a>
      </div>
    </div>
  </div>
</footer>
