---
import Icon from '../ui/Icon.astro';
import type { ServiceItem } from '../../data/services';

interface Props {
  service: ServiceItem;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
const isPriority = service.priorityTier === 'prioritario';
---

<article
  class:list={[
    'group relative flex flex-col justify-between rounded-md border bg-charcoal-900 p-6 md:p-8 transition-all duration-300',
    isPriority
      ? 'border-charcoal-750 hover:border-cobalt-500/80 bg-cobalt-chiaroscuro'
      : 'border-charcoal-750 hover:border-cobalt-600/60',
    featured && 'lg:p-9',
  ]}
>
  <div>
    <!-- Encabezado de tarjeta: Etiqueta categórica en Satoshi uppercase + Icono lineal 1.5px -->
    <div class="flex items-start justify-between gap-4 mb-6">
      <span
        class:list={[
          'inline-flex items-center px-3 py-1 rounded-sm text-xs font-sans font-semibold uppercase tracking-[0.08em] border',
          isPriority
            ? 'bg-cobalt-900/40 text-cobalt-400 border-cobalt-600/40'
            : 'bg-charcoal-850 text-ivory-300 border-charcoal-750',
        ]}
      >
        {service.categoryTag}
      </span>

      <div class="w-10 h-10 rounded-sm bg-charcoal-850 border border-charcoal-750 flex items-center justify-center text-cobalt-400 shrink-0 group-hover:border-cobalt-500/60 group-hover:text-ivory-50 transition-colors">
        <Icon name={service.icon} class="w-5 h-5" />
      </div>
    </div>

    <!-- Título en Cabinet Grotesk -->
    <h3 class="font-display font-bold text-xl sm:text-2xl text-ivory-50 leading-snug mb-3 group-hover:text-ivory-100">
      {service.title}
    </h3>

    <!-- Resumen claro -->
    <p class="text-sm sm:text-base text-ivory-300 leading-relaxed mb-6">
      {service.summary}
    </p>

    <!-- Lista de alcances clave -->
    <div class="border-t border-charcoal-750 pt-5 mb-6">
      <p class="text-xs font-sans font-semibold uppercase tracking-[0.08em] text-slate-400 mb-3">
        Alcance principal
      </p>
      <ul class="space-y-2.5">
        {service.includes.map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-ivory-300">
            <Icon name="check" class="w-4 h-4 text-cobalt-400 shrink-0 mt-0.5" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Pie de tarjeta con enlace de exploración -->
  <div class="pt-4 border-t border-charcoal-750 flex items-center justify-between">
    <a
      href={service.href}
      data-track="service_card_click"
      data-track-location="service-card"
      data-track-context={service.shortTitle}
      class="inline-flex items-center gap-2 text-sm font-medium text-ivory-50 group-hover:text-cobalt-400 transition-colors py-1"
    >
      <span>{service.ctaLabel}</span>
      <Icon
        name="arrow-right"
        class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
      />
    </a>
  </div>
</article>
