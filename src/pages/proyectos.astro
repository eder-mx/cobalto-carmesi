---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import ConversionCalendarBlock from '../components/sections/ConversionCalendarBlock.astro';
import { projects, projectCategories } from '../data/projects';
import { getWhatsAppUrl } from '../data/siteConfig';

const whatsappHref = getWhatsAppUrl('proyectos');
---

<Layout
  title="Proyectos y Casos de Estudio | Cobalto Carmesí Studios"
  description="Casos reales de marca personal, creación de contenido estratégico, fotografía comercial y dirección creativa ejecutados por Cobalto Carmesí Studios."
  canonicalPath="/proyectos"
  whatsappContext="proyectos"
>
  <!-- HERO DE PROYECTOS -->
  <section class="py-16 sm:py-24 bg-charcoal-950 bg-cobalt-chiaroscuro border-b border-charcoal-750">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        <span class="inline-flex items-center px-3 py-1 rounded-sm bg-charcoal-900 border border-charcoal-750 text-xs font-sans font-semibold uppercase tracking-[0.08em] text-cobalt-400">
          Portafolio Curado · Evidencia Estratégica y Visual
        </span>

        <h1 class="font-display font-bold text-4xl sm:text-5xl text-ivory-50 leading-[1.08] tracking-tight">
          Proyectos construidos desde el criterio, la luz y la narrativa.
        </h1>

        <p class="text-lg sm:text-xl text-ivory-300 leading-relaxed">
          Cada caso documenta el contexto real del cliente, la necesidad que enfrentaba, el alcance ejecutado y la aportación estratégica y estética de nuestro estudio.
        </p>
      </div>
    </div>
  </section>

  <!-- FILTRO DE CATEGORÍAS Y LISTADO DE CASOS REALES (CA-PORT-01 / CA-PORT-02) -->
  <section class="py-16 md:py-24 bg-charcoal-950 border-b border-charcoal-750">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Barra de filtros accesible por teclado -->
      <div
        class="flex flex-wrap items-center gap-2.5 mb-12 pb-6 border-b border-charcoal-750"
        role="group"
        aria-label="Filtrar casos de estudio por categoría"
      >
        {projectCategories.map((cat, idx) => (
          <button
            type="button"
            data-filter-btn
            data-filter-value={cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
            class:list={[
              'min-h-[44px] px-4 py-2 rounded-sm text-xs font-sans font-semibold uppercase tracking-[0.08em] border transition-colors',
              idx === 0
                ? 'bg-cobalt-600 text-ivory-50 border-cobalt-500'
                : 'bg-charcoal-900 text-ivory-300 border-charcoal-750 hover:border-cobalt-500/60 hover:text-ivory-50',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid de Casos con los 5 puntos obligatorios (CA-PORT-01) -->
      <div id="projects-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {projects.map((project) => (
          <div id={project.slug} class="scroll-mt-24" data-project-wrapper data-category={project.category}>
            <ProjectCard project={project} compact={false} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOQUE EDITORIAL DE RESPALDO Y CONFIDENCIALIDAD (CA-PORT-02) -->
  <section class="py-16 md:py-20 bg-charcoal-900 border-b border-charcoal-750">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-md border border-charcoal-750 bg-charcoal-950 p-8 sm:p-10 lg:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <span class="inline-flex items-center gap-2 text-xs font-sans font-semibold uppercase tracking-[0.08em] text-cobalt-400">
              <Icon name="shield-check" class="w-4 h-4" />
              <span>Política de Curaduría y Confidencialidad</span>
            </span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-ivory-50 leading-snug">
              ¿Buscas referencias visuales de un giro empresarial o formato específico?
            </h2>
            <p class="text-sm sm:text-base text-ivory-300 leading-relaxed">
              En este sitio publicamos únicamente casos con autorización expresa de exhibición pública y en proceso de curaduría editorial. Por respeto a la privacidad de nuestros clientes particulares, eventos familiares y acuerdos corporativos, resguardamos parte de nuestro archivo fuera de línea. Durante nuestra videollamada de diagnóstico podemos compartirte muestras específicas afines a tu proyecto.
            </p>
          </div>
          <div class="lg:col-span-4 flex flex-col gap-3">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              data-track-cta="whatsapp_message"
              data-track-location="proyectos-confidencialidad"
              data-track-context="Solicitar referencias por WhatsApp"
              class="btn-secondary w-full justify-center"
            >
              <Icon name="message-circle" class="w-4 h-4 text-cobalt-400" />
              <span>Solicitar muestras por WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ConversionCalendarBlock
    eyebrow="Tu Proyecto en Manos del Estudio"
    title="Construyamos el siguiente caso de éxito para tu marca o perfil profesional."
    description="Agenda una videollamada de diagnóstico para analizar tu contexto actual y diseñar un alcance de producción con dirección creativa real."
    primaryCtaLabel="Agendar videollamada"
    secondaryCtaLabel="Escribir por WhatsApp"
    whatsappContext="proyectos"
  />

  <script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-btn]');
    const projectWrappers = document.querySelectorAll<HTMLElement>('[data-project-wrapper]');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-filter-value') || 'Todos';

        filterButtons.forEach((b) => {
          const isCurrent = b === btn;
          b.setAttribute('aria-pressed', String(isCurrent));
          b.classList.toggle('bg-cobalt-600', isCurrent);
          b.classList.toggle('text-ivory-50', isCurrent);
          b.classList.toggle('border-cobalt-500', isCurrent);
          b.classList.toggle('bg-charcoal-900', !isCurrent);
          b.classList.toggle('text-ivory-300', !isCurrent);
          b.classList.toggle('border-charcoal-750', !isCurrent);
        });

        projectWrappers.forEach((wrapper) => {
          const cat = wrapper.getAttribute('data-category');
          const shouldShow = selected === 'Todos' || cat === selected;
          wrapper.classList.toggle('hidden', !shouldShow);
        });
      });
    });
  </script>
</Layout>
